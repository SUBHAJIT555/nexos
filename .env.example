# Copy this file to `.env.local` when a value is actually needed.
#
# No secrets are required yet. Do not invent payment keys or API tokens.

# Public site origin for canonical URLs, Open Graph, sitemap, and robots.
# Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=

# Optional docs destination. Defaults to the internal /docs route.
# NEXT_PUBLIC_DOCS_URL=
